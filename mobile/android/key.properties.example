# Example Android Release Keystore Configuration
# Copy this file to `mobile/android/key.properties` and fill in your real release credentials.
# NEVER commit `key.properties` or `.keystore` / `.jks` files to version control!

storePassword=your_keystore_password
keyPassword=your_key_password
keyAlias=your_key_alias
storeFile=/path/to/your/upload-keystore.jks
